[Desktop Entry]
Type=Application
Name=Wye
GenericName=Browser Picker
Comment=Send every link to the right browser, profile or app
# Launchers that honour DBusActivatable hand links to the running service
# (org.freedesktop.Application on dev.soldunov.wye, DEF-04); Exec is the
# fallback for those that do not.
DBusActivatable=true
Exec=wye open %U
Icon=dev.soldunov.wye
Terminal=false
StartupNotify=true
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;
Keywords=
Actions=settings;clipboard;

[Desktop Action settings]
Name=Settings
Exec=wye settings

[Desktop Action clipboard]
Name=Open URL from Clipboard
Exec=wye clipboard
